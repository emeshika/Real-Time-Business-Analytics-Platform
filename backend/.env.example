# ── MongoDB Configuration ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=stream_analytics

# Collection names (optional – defaults shown)
MONGODB_TRANSACTIONS_COLLECTION=transactions
MONGODB_HOURLY_COLLECTION=hourly_metrics
MONGODB_DAILY_COLLECTION=daily_metrics

# ── Kafka Configuration ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=live-business-transactions
